## ---------------------------------------------------------
## Welcome message
## ---------------------------------------------------------

.First <- function() {
  cat(
    "\n\033[1mHi, ", Sys.getenv("USER"), "!\033[0m",
    " We're working in: ", getwd(), "\n\n",
    sep = ""
  )
}

## ---------------------------------------------------------
## Load private secrets (not tracked in Git)
## ---------------------------------------------------------

local({

  secrets_file <- path.expand("~/.R/Rsecrets")

  if (file.exists(secrets_file)) {

    readRenviron(secrets_file)

  } else {

    message(
      "Secrets file not found: ",
      secrets_file,
      "\nCreate it to store private tokens (e.g. GITHUB_PAT)."
    )

  }

})

## ---------------------------------------------------------
## CRAN mirror
## ---------------------------------------------------------

local({

  r <- getOption("repos")
  r["CRAN"] <- "https://ftp.fau.de/cran/"
  options(repos = r)

})

## ---------------------------------------------------------
## Warn on partial matches
## ---------------------------------------------------------

options(
  warnPartialMatchAttr   = TRUE,
  warnPartialMatchDollar = TRUE,
  warnPartialMatchArgs   = TRUE
)

## ---------------------------------------------------------
## Avoid fancy quotes
## ---------------------------------------------------------

options(useFancyQuotes = FALSE)

## ---------------------------------------------------------
## Preferred editor
## ---------------------------------------------------------

options(editor = "nvim")

## ---------------------------------------------------------
## Custom prompt
## ---------------------------------------------------------

options(
  prompt   = "R> ",
  continue = "  "
)

## ---------------------------------------------------------
## Package name autocompletion in library()/require()
